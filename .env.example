# Copy to .env and fill in. NEVER commit the real .env (see .gitignore).
# All settings are read by src/jobagent/config.py via pydantic-settings.

# --- LLM: multi-provider with automatic failover ---
# Set any subset of keys. The chain tries the primary first, then falls through to
# the next provider that has a key on any error / rate-limit / quota exhaustion.
LLM_PROVIDER=groq                  # primary: groq | gemini | openrouter | openai | anthropic
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
QWEN_API_KEY=                       # DashScope (Alibaba); Qwen is also on OpenRouter
# Per-provider model overrides (free-friendly defaults shown):
GROQ_MODEL=llama-3.3-70b-versatile   # free; 8b-instant is slightly faster but cannot run tool loops
OPENROUTER_MODEL=openai/gpt-oss-20b:free
GEMINI_MODEL=gemini-2.0-flash
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-sonnet-4-6
QWEN_MODEL=qwen-plus
# Custom OpenAI-compatible endpoint (Ollama / vLLM / any local or hosted server):
CUSTOM_LLM_BASE_URL=                # e.g. http://localhost:11434/v1  (set LLM_PROVIDER=custom to prefer it)
CUSTOM_LLM_API_KEY=                 # blank is fine for local servers
CUSTOM_LLM_MODEL=                   # e.g. llama3.1

# --- Dashboard config UI (v2.1) ---
DASHBOARD_PASSWORD=                 # set to enable editing config from the dashboard (gates /config)
JOBAGENT_MASTER_KEY=                # Fernet key for the encrypted secret store: python scripts/genkey.py

# --- Telegram: TWO distinct credentials, two distinct roles ---
# 1) Telethon (MTProto) — reads job-posting CHANNELS as your user account.
#    Get api_id / api_hash from https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=                                     # for first-run login
TELEGRAM_CHANNELS=                                  # comma-separated, e.g. @remote_jobs,@ai_jobs
TELEGRAM_SESSION=data/telegram                      # Telethon .session file path (gitignored)
TELEGRAM_FETCH_LIMIT=50                             # messages pulled per channel per run
# 2) Bot API — the bot you TALK TO. Get token from @BotFather.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=                                   # where the bot DMs you; = your user id for a personal bot
TELEGRAM_OWNER_ID=                                  # optional alias/fallback for the owner gate

# --- ATS boards to watch (comma-separated company slugs) ---
GREENHOUSE_SLUGS=                                   # e.g. stripe,airbnb
LEVER_SLUGS=                                        # e.g. netflix
ASHBY_SLUGS=                                        # e.g. ramp

# --- Job source: aggregator for Indeed / LinkedIn / Glassdoor / JobRight ---
SERPAPI_KEY=                                        # serpapi.com Google Jobs engine
APIFY_TOKEN=                                        # optional secondary aggregator

# --- Store ---
JOBAGENT_DB_PATH=data/jobagent.db                   # sqlite for v1; swap to postgres URL later
# Your profile/preferences and CV live in these gitignored files, edited via Settings.
# Defaults are fine; override only to relocate them. Never commit real identity (R22).
JOBAGENT_PROFILE_PATH=data/profile.json
JOBAGENT_CV_PATH=data/cv_master.md

# --- Email sending (Tier 1 apply) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
APPLY_FROM_EMAIL=

# --- API security (Tier 1) ---
# Comma-separated browser origins allowed to call the API. Defaults to the local
# dashboard only; add your deployed dashboard origin here. Never "*" in production —
# write routes can send email as you.
JOBAGENT_CORS_ORIGINS=http://localhost:1234,http://127.0.0.1:1234

# Gate GET routes too. Off by default, which is correct on the 127.0.0.1 bind: the
# dashboard renders reads server-side with no token to offer. Turn it ON for any
# deployment the network can reach — /applications and /followups reveal where you
# applied and what was rejected. The dashboard then needs JOBAGENT_API_TOKEN
# (get it from `python scripts/api_token.py`). See SECURITY.md.
JOBAGENT_REQUIRE_AUTH_READS=false
# Only the DASHBOARD needs this, and only when the above is true.
JOBAGENT_API_TOKEN=

# Requests per hour per client, per class. Generous by design — these stop a runaway
# loop or an exposed port draining an LLM quota, not normal use. 0 disables a class.
JOBAGENT_RATE_LIMIT_ENABLED=true
JOBAGENT_RATE_LIMIT_ASSISTANT=60
JOBAGENT_RATE_LIMIT_INGEST=20
JOBAGENT_RATE_LIMIT_WRITE=600

# --- Dashboard → API addressing ---
# JOBAGENT_API_URL is what the dashboard SERVER calls (SSR, may be 127.0.0.1).
# PUBLIC_JOBAGENT_API_URL is what the visitor's BROWSER calls — set this whenever the
# dashboard and API are not on the same machine (e.g. dashboard on Vercel, API on a VPS).
JOBAGENT_API_URL=http://127.0.0.1:8077
PUBLIC_JOBAGENT_API_URL=
