# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Secrets — NEVER commit
.env
.env.*
!.env.example
.envdir/
*.session            # Telethon user-account sessions
*.session-journal
secrets/

# Local data store
*.db
*.db-journal
*.sqlite
*.sqlite3
data/

# Generated application assets (CV variants, cover letters)
artifacts/
cv_master.md

# Personal identity, search profile + CV. The repo ships templates only:
# `config/preferences.example.toml` is committed; your real `preferences.toml` is not.
# A PII scrub is not a personalization scrub — roles, skills, weights and a company
# watchlist are just as much "yours" as a phone number, and a clone that inherits them
# silently searches someone else's job market.
config/preferences.toml
config/preferences.local.toml
!config/preferences.example.toml

# CVs and resumes, any spelling, anywhere — case classes spelled out because gitignore
# matching is case-SENSITIVE on Linux even though macOS hides that.
*[Cc][Vv]*.pdf
*[Rr]esume*.pdf
*[Rr]esume*.docx
*[Cc][Vv]*.docx



# Dashboard (Astro / Node)
dashboard/node_modules/
dashboard/dist/
dashboard/.astro/

# OS / editor
.DS_Store
.idea/
.vscode/

# Claude Code machine-local settings (permission allowlist)
.claude/settings.local.json
