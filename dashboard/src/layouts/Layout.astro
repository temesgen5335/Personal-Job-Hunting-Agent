---
// Sidebar shell (design: Job Agent.dc.html). The nav carries live badges — queue
// count on Jobs, quiet-application count on Applications, a pulsing dot on Overview
// when the pipeline is degraded — so the "do I need to look?" answer is visible from
// any page. Badge data comes from the same API the pages use; a failed fetch just
// hides the badges rather than breaking the page.
import { getStats, getFollowups, type Stats } from "../lib/api";

const { title = "Job Agent" } = Astro.props;
const path = Astro.url.pathname;

let stats: Stats | null = null;
let nudgeCount = 0;
try {
  stats = await getStats();
  nudgeCount = (await getFollowups(7)).followups.length;
} catch {
  /* API down — pages render their own unreachable state; nav shows no badges */
}
const queueCount = stats?.queue ?? 0;
const degraded =
  !!stats?.health &&
  (stats.health.is_stale ||
    stats.health.recent_errors > 0 ||
    stats.health.sources.some((s) => (s.hours_since ?? 0) > 48));

const nav = [
  { href: "/", label: "Overview", key: "overview" },
  { href: "/jobs", label: "Jobs", key: "jobs" },
  { href: "/applications", label: "Applications", key: "applications" },
  { href: "/settings", label: "Settings", key: "settings" },
];
const isActive = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Job Agent</title>
    <!--
      Shared client-side auth for dashboard actions (triage, fit check, status edits,
      follow-up drafts). Every API write needs the bearer token minted by the Settings
      login. `is:inline` keeps this un-bundled so it runs before page scripts.
    -->
    <script is:inline>
      window.JA = {
        token: () => localStorage.getItem("jobagent_token"),
        headers() {
          const t = this.token();
          const h = { "Content-Type": "application/json" };
          if (t) h.Authorization = `Bearer ${t}`;
          return h;
        },
        explain(status) {
          return status === 401 || status === 403
            ? "Not signed in — open Settings, sign in, then retry."
            : `HTTP ${status}`;
        },
      };
    </script>
  </head>
  <body>
    <div class="shell">
      <nav class="side">
        <div class="brand">
          <span class:list={["brand-dot", degraded && "bad"]}></span>
          <span class="brand-name">job&#8202;agent</span>
        </div>
        <div class="side-nav">
          {nav.map((n) => (
            <a href={n.href} class:list={["side-link", isActive(n.href) && "on"]}>
              <span>{n.label}</span>
              {n.key === "overview" && degraded && <span class="health-dot"></span>}
              {n.key === "jobs" && queueCount > 0 && (
                <span class="queue-badge">{queueCount}</span>
              )}
              {n.key === "applications" && nudgeCount > 0 && (
                <span class="nudge-badge">{nudgeCount}</span>
              )}
            </a>
          ))}
        </div>
      </nav>
      <main class="content"><slot /></main>
    </div>

    <style is:global>
      :root {
        /* Palette shared with temesgendev.vercel.app (neutral dark + sky accent) */
        --bg: #0a0a0a;
        --panel: #111111;
        --hover: #1c1c1c;
        --border: #262626;
        --text: #e5e5e5;
        --strong: #fafafa;
        --muted: #737373;
        --faint: #585858;
        --accent: #7dd3fc;
        --accent-dim: rgba(125, 211, 252, 0.13);
        --good: #4ade80;
        --warn: #fbbf24;
        --danger: #f87171;
        --info: #60a5fa;
        --radius: 12px;
        --radius-sm: 8px;
        --font: ui-sans-serif, -apple-system, "Segoe UI", Roboto, Inter, system-ui, sans-serif;
        --mono: ui-monospace, "SF Mono", "JetBrains Mono", Menlo, monospace;
      }
      * { box-sizing: border-box; }
      html { color-scheme: dark; }
      html, body { margin: 0; padding: 0; background: var(--bg); }
      body { font: 14px/1.45 var(--font); color: var(--text); -webkit-font-smoothing: antialiased; }
      button, input, select, textarea { font: inherit; color: inherit; }
      ::selection { background: rgba(125, 211, 252, 0.25); }
      :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 4px; }
      ::-webkit-scrollbar { width: 10px; height: 10px; }
      ::-webkit-scrollbar-thumb { background: var(--border); border-radius: 8px; }
      ::-webkit-scrollbar-track { background: transparent; }
      a { color: var(--accent); text-decoration: none; }
      a:hover { text-decoration: underline; text-underline-offset: 3px; }
      @keyframes spin { to { transform: rotate(360deg); } }
      @keyframes pulsedot { 0%, 100% { opacity: 1; } 50% { opacity: 0.25; } }

      /* ---- shell ------------------------------------------------------------- */
      .shell { display: flex; flex-wrap: wrap; align-items: stretch; min-height: 100vh; }
      .side {
        width: 196px; flex: none; border-right: 1px solid var(--border);
        padding: 20px 8px; display: flex; flex-direction: column; gap: 4px;
        position: sticky; top: 0; align-self: flex-start; height: 100vh;
      }
      .brand { display: flex; align-items: center; gap: 8px; padding: 0 12px 18px; }
      .brand-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--good); display: block; }
      .brand-dot.bad { background: var(--danger); }
      .brand-name { font-family: var(--mono); font-size: 12px; letter-spacing: 0.06em; color: var(--strong); }
      .side-nav { display: flex; flex-direction: column; gap: 2px; }
      .side-link {
        display: flex; align-items: center; gap: 8px; width: 100%;
        border-radius: 8px; padding: 7px 12px; font-size: 13.5px;
        color: var(--muted); white-space: nowrap;
      }
      .side-link:hover { background: var(--hover); color: var(--text); text-decoration: none; }
      .side-link.on { background: var(--hover); color: var(--strong); }
      .health-dot {
        width: 5px; height: 5px; border-radius: 50%; background: var(--danger);
        display: block; margin-left: auto; animation: pulsedot 1.6s ease-in-out infinite;
      }
      .queue-badge {
        margin-left: auto; font-family: var(--mono); font-size: 11px; color: var(--accent);
        background: var(--accent-dim); border-radius: 999px; padding: 0 6px;
      }
      .nudge-badge { margin-left: auto; font-family: var(--mono); font-size: 11px; color: var(--warn); }
      .content { flex: 1; min-width: 0; padding: 28px 34px 64px; max-width: 1180px; }
      @media (max-width: 820px) {
        .side { width: 100%; height: auto; position: static; border-right: 0; border-bottom: 1px solid var(--border); }
        .side-nav { flex-direction: row; overflow-x: auto; }
        .content { padding: 20px 16px 48px; }
      }

      /* ---- shared primitives --------------------------------------------------- */
      h1.page { margin: 0; font-size: 21px; font-weight: 600; letter-spacing: -0.02em; color: var(--strong); }
      .page-sub { color: var(--muted); font-size: 13px; margin-top: 3px; }
      .page-head { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin-bottom: 18px; }
      .panel { border: 1px solid var(--border); background: var(--panel); border-radius: var(--radius); padding: 16px 18px; }
      .k { font-size: 10px; letter-spacing: 0.09em; text-transform: uppercase; color: var(--faint); }
      .mono { font-family: var(--mono); }
      .muted { color: var(--muted); }
      .faint { color: var(--faint); }

      .btn {
        border: 1px solid var(--border); background: transparent; color: var(--text);
        border-radius: var(--radius-sm); padding: 7px 13px; font-size: 13px; cursor: pointer;
      }
      .btn:hover { background: var(--hover); }
      .btn.primary { border-color: rgba(125, 211, 252, 0.4); background: var(--accent-dim); color: var(--accent); }
      .btn.primary:hover { background: rgba(125, 211, 252, 0.2); }
      .btn.quiet { color: var(--muted); }
      .btn.quiet:hover { color: var(--text); }
      .btn.danger-hover:hover { background: rgba(248, 113, 113, 0.1); color: var(--danger); border-color: rgba(248, 113, 113, 0.3); }
      .btn.sm { padding: 3px 8px; font-size: 11.5px; border-radius: 6px; color: var(--muted); background: var(--panel); }
      .btn.sm:hover { color: var(--text); background: var(--hover); }
      .btn.sm.danger-hover:hover { color: var(--danger); background: rgba(248, 113, 113, 0.08); border-color: rgba(248, 113, 113, 0.3); }
      .btn:disabled { opacity: 0.55; cursor: default; }
      .linkish {
        border: 0; background: transparent; color: var(--muted); font-size: 12px; cursor: pointer;
        text-decoration: underline; text-underline-offset: 3px; padding: 0;
      }
      .linkish:hover { color: var(--text); }

      .chip-ok {
        border: 1px solid rgba(74, 222, 128, 0.22); background: rgba(74, 222, 128, 0.07);
        color: #86efac; border-radius: 5px; padding: 2px 7px; font-size: 11.5px; font-family: var(--mono);
      }
      .chip-gap {
        border: 1px solid var(--border); color: var(--muted);
        border-radius: 5px; padding: 2px 7px; font-size: 11.5px; font-family: var(--mono);
      }
      .set-badge {
        border: 1px solid rgba(74, 222, 128, 0.25); background: rgba(74, 222, 128, 0.07);
        color: #86efac; border-radius: 4px; padding: 1px 6px; font-size: 10.5px; font-family: var(--mono);
      }
      .set-badge.no { border-color: rgba(248, 113, 113, 0.28); background: rgba(248, 113, 113, 0.07); color: var(--danger); }

      .field input, .field select {
        width: 100%; background: #0d0d0d; border: 1px solid var(--border);
        border-radius: var(--radius-sm); padding: 7px 10px; font-size: 13px; color: var(--text);
      }
      .field > span { display: flex; align-items: center; gap: 8px; font-size: 11.5px; color: var(--muted); margin-bottom: 5px; }
      .spinner {
        width: 13px; height: 13px; border: 1.5px solid var(--border); border-top-color: var(--accent);
        border-radius: 50%; display: inline-block; animation: spin 0.8s linear infinite;
      }
    </style>
  </body>
</html>
