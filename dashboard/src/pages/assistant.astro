---
// The full-page assistant.
//
// It mounts the *same* client module as the floating bubble, over the same stored
// session — so a question asked in the bubble is already here when you open this page,
// and vice versa. The two surfaces differ only in the frame around the thread; the
// thread itself is rendered by one function, which is why they cannot drift.
import Layout from "../layouts/Layout.astro";
import { publicApiBase } from "../lib/api";

// The browser fetches this itself, so it needs the *public* base — a server-side
// 127.0.0.1 means the visitor's own laptop once it reaches a browser.
const publicUrl = publicApiBase();
---

<Layout title="Assistant">
  <header class="page-head">
    <div>
      <h1>Assistant</h1>
      <p class="sub">
        Ask about the pipeline, your queue, or your settings. It reads; it cannot
        send or approve anything.
      </p>
    </div>
    <div class="head-actions">
      <button id="page-new" class="ghost" type="button"
              title="Start a fresh conversation">New chat</button>
      <button id="page-reindex" class="ghost" type="button"
              title="Rebuild the posting search index">Reindex postings</button>
    </div>
  </header>

  <div class="ja-thread page-thread" id="page-thread" role="log" aria-live="polite"
       data-base={publicUrl}></div>

  <form class="ja-composer page-composer" id="page-form">
    <input id="page-input" type="text" autocomplete="off" maxlength="2000"
           placeholder="Ask about your pipeline…" aria-label="Ask the assistant" />
    <button type="submit" id="page-send">Ask</button>
  </form>

  <style is:global>
    .page-head { display: flex; align-items: flex-start; justify-content: space-between;
                 gap: 16px; margin-bottom: 20px; flex-wrap: wrap; }
    .page-head h1 { margin: 0 0 4px; font-size: 20px; color: var(--strong); }
    .page-head .sub { margin: 0; color: var(--muted); font-size: 13px; max-width: 60ch; }
    .head-actions { display: flex; gap: 8px; }
    .ghost { background: var(--panel); border: 1px solid var(--border); color: var(--text);
             border-radius: var(--radius); padding: 9px 15px; cursor: pointer; font-size: 13px; }
    .ghost:hover { background: var(--hover); border-color: var(--accent); }

    /* The page frames the same thread differently: it scrolls with the document and
       the composer is docked, where the panel scrolls internally. */
    .page-thread { margin-bottom: 96px; overflow: visible; }
    .page-composer {
      position: fixed; bottom: 0; right: 0; left: var(--side-w, 210px);
      padding: 14px 28px;
      background: linear-gradient(transparent, var(--bg) 30%);
    }
    @media (max-width: 720px) { .page-composer { left: 0; padding: 12px 16px; } }
  </style>

  <script>
    import { ask, clearSession, mount } from "../lib/assistant";

    const root = document.getElementById("page-thread") as HTMLElement;
    const input = document.getElementById("page-input") as HTMLInputElement;
    const base = root.dataset.base || "";

    mount({
      root,
      form: document.getElementById("page-form") as HTMLFormElement,
      input,
      send: document.getElementById("page-send") as HTMLButtonElement,
      base,
      scroll: document.scrollingElement as HTMLElement,
    });

    document.getElementById("page-new")!.onclick = () => {
      clearSession();
      input.focus();
    };
    // Reindexing is slow and invisible, so it is phrased as a question whose answer
    // proves it happened rather than a button that silently returns.
    document.getElementById("page-reindex")!.onclick = () =>
      ask(base, "How many postings are indexed now?", { reindex: true });
  </script>
</Layout>
