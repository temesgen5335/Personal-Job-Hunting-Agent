---
// Settings (design: Job Agent.dc.html). Locked gate first — these fields hold live
// credentials — then grouped editors with set / not-set badges. Secrets are never
// echoed by the API; a blank field keeps the stored value.
import Layout from "../layouts/Layout.astro";
import { publicApiBase } from "../lib/api";
// Browser-facing URL: these fetches run in the visitor's browser, not on the server.
const apiUrl = publicApiBase();
---

<Layout title="Settings">
  <div id="login" class="lock" style="display:none">
    <div style="font-size:16px;color:var(--strong)">Settings are locked</div>
    <p style="font-size:13px;color:var(--muted);margin:8px 0 18px">
      These fields hold live credentials. Enter the dashboard password to edit them.
    </p>
    <form id="login-form" style="display:flex;gap:8px">
      <input type="password" id="password" placeholder="Password" autocomplete="current-password"
             style="flex:1;background:#0d0d0d;border:1px solid var(--border);border-radius:8px;padding:8px 11px;font-size:13px;color:var(--text)" />
      <button type="submit" class="btn primary" style="padding:8px 14px">Unlock</button>
    </form>
    <div id="login-msg" class="muted" style="font-size:12px;margin-top:10px"></div>
  </div>

  <div id="config" style="display:none;max-width:620px">
    <div style="margin-bottom:18px">
      <h1 class="page">Settings</h1>
      <div class="page-sub">Secrets are never returned by the API. Leave a field blank to keep the stored value.</div>
    </div>
    <div id="form"></div>
    <div style="display:flex;gap:8px;margin-top:16px;align-items:center">
      <button id="save" class="btn primary" style="padding:8px 15px">Save changes</button>
      <button id="logout" class="btn quiet" style="padding:8px 15px">Lock</button>
      <span id="save-msg" class="muted" style="font-size:12.5px"></span>
    </div>
  </div>

  <div id="error" class="panel" style="display:none;margin-top:14px"></div>

  <script is:inline define:vars={{ apiUrl }}>
    const TOKEN_KEY = "jobagent_token";
    const GROUPS = [
      // First group on purpose: this is the knob that decides what ever reaches the
      // store, so it should not be buried under credential fields.
      { title: "Ingestion filter", note:
          "Applied between fetch and store — filtered postings never enter your store " +
          "and never cost matching time. Blank = no filter. Fit judgment (skills, " +
          "seniority) is deliberately NOT here: the scorer does that reversibly.",
        fields: [
          { k: "ingest_sources", label: "Sources to fetch", type: "multi",
            hint: "Unchecking all falls back to [sources] in preferences.toml." },
          { k: "ingest_max_age_days", label: "Max posting age (days)",
            hint: "0 or blank = no age limit. Postings with no date are always kept." },
          { k: "ingest_locations", label: "Keep only these locations", type: "list",
            hint: "Comma-separated, any-match, e.g. remote, EMEA, Africa. \"remote\" also accepts the structured remote flag." },
          { k: "ingest_drop_keywords", label: "Drop if it mentions", type: "list",
            hint: "Comma-separated, e.g. unpaid, clearance required, US citizens only." },
        ]},
      { title: "LLM", fields: [
        { k: "llm_provider", label: "Primary provider", type: "select",
          options: ["groq", "gemini", "openrouter", "custom", "openai", "anthropic"] },
        { k: "groq_api_key", secret: true }, { k: "gemini_api_key", secret: true },
        { k: "openrouter_api_key", secret: true }, { k: "openai_api_key", secret: true },
        { k: "anthropic_api_key", secret: true },
        { k: "groq_model" }, { k: "gemini_model" }, { k: "openrouter_model" },
        { k: "openai_model" }, { k: "anthropic_model" },
        { k: "custom_llm_base_url", label: "Custom base URL" },
        { k: "custom_llm_api_key", secret: true }, { k: "custom_llm_model" },
      ]},
      { title: "Telegram", fields: [
        { k: "telegram_bot_token", secret: true }, { k: "telegram_chat_id" },
        { k: "telegram_api_id" }, { k: "telegram_api_hash", secret: true },
        { k: "telegram_phone" }, { k: "telegram_channels" },
      ]},
      { title: "SMTP", fields: [
        { k: "smtp_host" }, { k: "smtp_port" }, { k: "smtp_user" },
        { k: "smtp_password", secret: true }, { k: "apply_from_email" },
      ]},
    ];
    const ALL = GROUPS.flatMap((g) => g.fields);
    const SECRET = new Set(ALL.filter((f) => f.secret).map((f) => f.k));
    const labelOf = (f) => f.label || f.k.replace(/_/g, " ").replace(/\b\w/g, (c) => c.toUpperCase());

    const $ = (id) => document.getElementById(id);
    const token = () => localStorage.getItem(TOKEN_KEY);
    const headers = () => ({ "Content-Type": "application/json", Authorization: `Bearer ${token()}` });
    function showError(msg) { const e = $("error"); e.style.display = "block"; e.textContent = "⚠️ " + msg; }

    async function login(ev) {
      ev.preventDefault();
      $("login-msg").textContent = "…";
      try {
        const r = await fetch(`${apiUrl}/auth/login`, {
          method: "POST", headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ password: $("password").value }),
        });
        if (!r.ok) {
          $("login-msg").textContent = r.status === 401 ? "Wrong password."
            : r.status === 403 ? "Editing is disabled — set DASHBOARD_PASSWORD on the API."
            : `error ${r.status}`;
          return;
        }
        localStorage.setItem(TOKEN_KEY, (await r.json()).token);
        $("login-msg").textContent = "";
        await loadConfig();
      } catch (e) { showError(`Can't reach API at ${apiUrl} — ${e.message}`); }
    }

    function renderForm(cfg, sourceInfo) {
      const esc = (t) => String(t == null ? "" : t).replace(/"/g, "&quot;");
      const html = GROUPS.map((g) => `
        <section class="s-group"><div class="s-title">${g.title}</div>
        ${g.note ? `<p class="s-note">${g.note}</p>` : ""}
        <div class="s-fields">
        ${g.fields.map((f) => {
          const v = cfg[f.k];
          let input, badge = "";
          if (f.type === "multi") {
            // Checkbox chips rather than a <select multiple>: the whole point is
            // seeing at a glance which sources are on.
            const available = (sourceInfo && sourceInfo.available) || [];
            const chosen = new Set(String(v || "").split(",").map((x) => x.trim()).filter(Boolean));
            // Nothing stored → show what is actually resolved (the TOML fallback),
            // so the boxes reflect the run that would happen right now.
            const effective = chosen.size ? chosen : new Set((sourceInfo && sourceInfo.enabled) || []);
            const counts = (sourceInfo && sourceInfo.in_store) || {};
            input = `<span class="src-picker" id="f_${f.k}">` + available.map((o) => `
              <label class="src-chip">
                <input type="checkbox" value="${esc(o)}" ${effective.has(o) ? "checked" : ""} />
                <span>${esc(o)}</span>
                <span class="src-n mono">${counts[o] ? counts[o] : ""}</span>
              </label>`).join("") + `</span>`;
          } else if (f.type === "select") {
            input = `<select id="f_${f.k}">${f.options.map((o) =>
              `<option value="${o}" ${o === v ? "selected" : ""}>${o}</option>`).join("")}</select>`;
          } else if (f.secret) {
            const set = v && v.set;
            badge = `<span class="set-badge ${set ? "" : "no"}">${set ? "set" : "not set"}</span>`;
            input = `<input id="f_${f.k}" type="password" placeholder="${set ? "blank to keep" : "not set"}" autocomplete="off" />`;
          } else {
            input = `<input id="f_${f.k}" type="text" value="${esc(v)}" class="mono" placeholder="${esc(f.placeholder || "")}" />`;
          }
          return `<label class="field"><span>${labelOf(f)} ${badge}</span>${input}` +
                 (f.hint ? `<span class="f-hint">${f.hint}</span>` : "") + `</label>`;
        }).join("")}
        </div></section>`).join("");
      $("form").innerHTML = html;
    }

    async function loadConfig() {
      try {
        const r = await fetch(`${apiUrl}/config`, { headers: headers() });
        if (r.status === 401 || r.status === 403) { localStorage.removeItem(TOKEN_KEY); return gate(); }
        if (!r.ok) return showError(`config load failed (${r.status})`);
        // /sources is a public read; a failure there must not block the config form.
        const sourceInfo = await fetch(`${apiUrl}/sources`).then((x) => x.json()).catch(() => null);
        renderForm((await r.json()).config, sourceInfo);
        $("login").style.display = "none";
        $("config").style.display = "block";
      } catch (e) { showError(`Can't reach API at ${apiUrl} — ${e.message}`); }
    }

    async function save() {
      const patch = {};
      for (const f of ALL) {
        const el = $(`f_${f.k}`); if (!el) continue;
        if (f.type === "multi") {
          patch[f.k] = [...el.querySelectorAll("input:checked")].map((c) => c.value).join(",");
          continue;
        }
        const val = el.value.trim();
        if (SECRET.has(f.k)) { if (val) patch[f.k] = val; }   // blank secret = keep existing
        else patch[f.k] = val;
      }
      $("save-msg").textContent = "saving…";
      try {
        const r = await fetch(`${apiUrl}/config`, { method: "PUT", headers: headers(), body: JSON.stringify({ values: patch }) });
        if (!r.ok) { $("save-msg").textContent = `error ${r.status}`; return; }
        const sourceInfo = await fetch(`${apiUrl}/sources`).then((x) => x.json()).catch(() => null);
        renderForm((await r.json()).config, sourceInfo);
        $("save-msg").textContent = "saved ✓ · applies to the next fetch";
        setTimeout(() => { $("save-msg").textContent = ""; }, 2500);
      } catch (e) { showError(e.message); }
    }

    function gate() {
      $("config").style.display = "none";
      $("login").style.display = "block";
    }

    $("login-form").addEventListener("submit", login);
    $("save").addEventListener("click", save);
    $("logout").addEventListener("click", () => { localStorage.removeItem(TOKEN_KEY); gate(); });
    token() ? loadConfig() : gate();
  </script>
</Layout>

<style is:global>
  .lock { max-width: 340px; margin: 16vh auto; text-align: center; }
  .s-group {
    border: 1px solid var(--border); background: var(--panel);
    border-radius: var(--radius); padding: 16px 18px; margin-bottom: 14px;
  }
  .s-title { font-size: 12px; color: var(--strong); margin-bottom: 14px; }
  .s-fields { display: grid; gap: 12px; }
  .s-note { font-size: 12px; color: var(--muted); line-height: 1.55; margin: -6px 0 14px; }
  .f-hint { display: block; font-size: 11.5px; color: var(--faint); margin-top: 5px; line-height: 1.5; }
  .src-picker { display: flex; flex-wrap: wrap; gap: 6px; }
  .src-chip {
    display: inline-flex; align-items: center; gap: 6px; cursor: pointer;
    border: 1px solid var(--border); background: #0d0d0d; border-radius: 999px;
    padding: 4px 11px 4px 9px; font-size: 12.5px; font-family: var(--mono);
  }
  .src-chip:hover { border-color: var(--border-2, #404040); }
  .src-chip:has(input:checked) {
    border-color: rgba(125, 211, 252, 0.4); background: var(--accent-dim); color: var(--accent);
  }
  .src-chip input { accent-color: var(--accent); margin: 0; }
  .src-n { color: var(--faint); font-size: 10.5px; }
</style>
